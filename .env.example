# Copy to .env and set the HTTPS URL and SMTP credentials for your instance.
COOKBOOK_PUBLIC_URL=https://cookbook.example.test
# Optional; required before enabling the future federation feature. Immutable after federation is enabled.
COOKBOOK_FEDERATION_ORIGIN=
COOKBOOK_RP_ID=cookbook.example.test
COOKBOOK_RP_ORIGIN=https://cookbook.example.test
# Initial registration mode; administrators can change this in the app after setup.
COOKBOOK_REGISTRATION=invite_only
# Local recipe image directory (default: alongside the SQLite database).
COOKBOOK_MEDIA_DIR=./data/media
# Days before trashed recipes and their revisions are permanently removed; 0 disables cleanup.
COOKBOOK_TRASH_RETENTION_DAYS=30
COOKBOOK_ADMIN_EMAIL=
COOKBOOK_ADMIN_NAME=Instance Owner
COOKBOOK_SMTP_HOST=mail.example.test:587
COOKBOOK_SMTP_FROM=cookbook@example.test
COOKBOOK_SMTP_USERNAME=
COOKBOOK_SMTP_PASSWORD=

# Optional trusted reverse proxy IP CIDRs, comma separated; leave blank unless proxy network is controlled.
COOKBOOK_TRUSTED_PROXIES=
