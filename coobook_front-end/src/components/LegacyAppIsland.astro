---
import App from '../App.jsx'

interface Props {
  pageTitle: string
  description: string
}

const { pageTitle, description } = Astro.props
const confirming = Astro.url.pathname === '/auth/confirm'
---

<App client:only="react">
  <div slot="fallback" class="app-shell">
    <header class="topbar">
      <a href="#home" class="brand" aria-label="Cookbook home">
        <span class="brand-mark" aria-hidden="true">✳</span>
        <span>Cookbook</span>
      </a>
    </header>
    <main id="home" class="hero">
      <div class="hero__copy">
        <span class="eyebrow">Good food, gathered</span>
        <h1>{confirming ? pageTitle : <>A little more<br /><em>home</em> in every meal.</>}</h1>
        <p>{description}</p>
        <span role="status">Loading Cookbook…</span>
      </div>
      {!confirming && <div class="hero__image" role="img" aria-label="A table filled with a fresh seasonal meal"></div>}
    </main>
  </div>
</App>
