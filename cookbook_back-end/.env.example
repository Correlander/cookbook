# Bind to loopback behind a trusted HTTPS reverse proxy in production.
COOKBOOK_ADDR=127.0.0.1:8000
COOKBOOK_DATABASE=./data/cookbook.db
COOKBOOK_PUBLIC_URL=http://localhost:8000
# Registration mode: invite_only by default. Set open explicitly to allow email registration.
COOKBOOK_REGISTRATION=invite_only
# Executable accepting one JSON object on stdin with to, subject, text, and sign_in_url fields.
# The one-time sign-in URL is never passed as an argument or written to application logs.
COOKBOOK_EMAIL_COMMAND=/usr/local/bin/cookbook-mailer
