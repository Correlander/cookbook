# Bind to loopback behind a trusted HTTPS reverse proxy in production.
COOKBOOK_ADDR=127.0.0.1:8000
# Optional: trusted reverse-proxy IP CIDRs, comma separated; required to use X-Forwarded-For safely.
COOKBOOK_TRUSTED_PROXIES=
COOKBOOK_DATABASE=./data/cookbook.db
COOKBOOK_MEDIA_DIR=./data/media
COOKBOOK_PUBLIC_URL=http://localhost:5173
COOKBOOK_RP_ID=localhost
COOKBOOK_RP_ORIGIN=http://localhost:5173
# Initial registration mode: invite_only by default. Administrators can change it in the app after setup.
COOKBOOK_REGISTRATION=invite_only
# Days before trashed recipes and their revisions are permanently removed; 0 disables cleanup.
COOKBOOK_TRASH_RETENTION_DAYS=30
# Set once to create the first instance administrator, then remove it after setup.
COOKBOOK_ADMIN_EMAIL=
COOKBOOK_ADMIN_NAME=Instance Owner
# SMTP requires STARTTLS. If preferred, use COOKBOOK_EMAIL_COMMAND instead (JSON on stdin).
COOKBOOK_SMTP_HOST=mail.example.test:587
COOKBOOK_SMTP_FROM=cookbook@example.test
COOKBOOK_SMTP_USERNAME=
COOKBOOK_SMTP_PASSWORD=
