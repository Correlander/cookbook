FROM node:22.23.4-alpine AS build
WORKDIR /src/coobook_front-end
ENV ASTRO_TELEMETRY_DISABLED=1
COPY coobook_front-end/package.json coobook_front-end/package-lock.json ./
RUN npm ci
COPY coobook_front-end/ ./
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /src/coobook_front-end/dist /srv
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/coobook_front-end/dist/static-csp.caddy /etc/caddy/static-csp.caddy
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=3s --start-period=3s --retries=3 CMD wget -qO- http://127.0.0.1:8080/healthz >/dev/null || exit 1
